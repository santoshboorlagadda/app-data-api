## Oracle

Use `ALL_*` views if the objects live in another schema; swap `USER_` for `ALL_` and filter on
`OWNER`.

```sql
-- Columns
SELECT table_name, column_name, data_type, data_length, data_precision, data_scale, nullable
FROM   user_tab_columns
ORDER  BY table_name, column_id;

-- Object kinds
SELECT object_name, object_type
FROM   user_objects
WHERE  object_type IN ('TABLE','VIEW','MATERIALIZED VIEW');

-- Indexes
SELECT i.index_name, i.table_name, i.uniqueness,
       LISTAGG(c.column_name, ',') WITHIN GROUP (ORDER BY c.column_position) AS columns
FROM   user_indexes i
JOIN   user_ind_columns c ON c.index_name = i.index_name
GROUP  BY i.index_name, i.table_name, i.uniqueness;

-- Keys and foreign keys
SELECT c.constraint_name, c.table_name, c.constraint_type,
       cc.column_name, c.r_constraint_name
FROM   user_constraints c
JOIN   user_cons_columns cc ON cc.constraint_name = c.constraint_name
WHERE  c.constraint_type IN ('P','R','U');

-- Approximate row counts (needs current statistics)
SELECT table_name, num_rows AS approx_rows, last_analyzed
FROM   user_tables
ORDER  BY num_rows DESC;
```

def run(conn, sql):
    cur = conn.cursor()
    cur.execute(sql)
    rows = cur.fetchall()
    cur.close()
    return [tuple(r) for r in rows]


def keep(row, objects):
    if not objects:
        return True
    return any(str(cell).upper() in objects for cell in row[:3] if cell is not None)


def slug(name):
    return re.sub(r"[^a-z0-9_]+", "_", str(name).lower()).strip("_")


def md_table(rows, headers):
    if not rows:
        return "_none_\n"
    out = ["| " + " | ".join(headers) + " |",
           "|" + "|".join(["---"] * len(headers)) + "|"]
    for r in rows:
        cells = ["" if c is None else str(c).replace("|", "\\|") for c in r]
        out.append("| " + " | ".join(cells) + " |")
    return "\n".join(out) + "\n"


def yaml_escape(value):
    value = str(value or "").replace('"', "'").replace("\n", " ")
    return f'"{value}"'


def frontmatter(concept_type, title, description, tags, timestamp, resource=None):
    lines = ["---", f"type: {yaml_escape(concept_type)}", f"title: {yaml_escape(title)}",
             f"description: {yaml_escape(description)}"]
    if resource:
        lines.append(f"resource: {yaml_escape(resource)}")
    lines.append("tags: [" + ", ".join(tags) + "]")
    lines.append(f"timestamp: {timestamp}")
    lines.append("---")
    return "\n".join(lines) + "\n"


TYPE_NAME = {
    "postgres": {"BASE TABLE": "PostgreSQL Table", "VIEW": "PostgreSQL View",
                 "TABLE": "PostgreSQL Table"},
    "sqlserver": {"USER_TABLE": "SQL Server Table", "VIEW": "SQL Server View"},
    "oracle": {"TABLE": "Oracle Table", "VIEW": "Oracle View",
               "MATERIALIZED VIEW": "Oracle Materialized View"},
}


def group(rows, key_index):
    out = {}
    for r in rows:
        out.setdefault(r[key_index], []).append(r)
    return out


def write_bundle(out_dir, provider, host, database, sections, timestamp):
    """Write an OKF v0.1 bundle: docs/db/<provider>/<schema>/{tables,views,routines}/<obj>.md"""
    columns, _ = sections["columns"]
    indexes, _ = sections["indexes"]
    keys, _ = sections["keys"]
    counts, _ = sections["row_counts"]
    routines, _ = sections.get("routines", ([], []))

    # lookups keyed by (schema, object) so two schemas never collide
    idx_by, key_by, count_by = {}, {}, {}
    for r in indexes:
        idx_by.setdefault((r[0], r[1]), []).append(r)
    for r in keys:
        key_by.setdefault((r[0], r[1]), []).append(r)
    for r in counts:
        count_by[(r[0], r[1])] = (r[2], r[3])

    objects = {}
    for r in columns:
        objects.setdefault((r[0], r[1], r[2]), []).append(r)

    known = {(sch, name) for sch, name, _ in objects}
    written = {}          # schema -> {"tables": [...], "views": [...], "routines": [...]}

    def record(schema, folder, name):
        written.setdefault(schema, {"tables": [], "views": [], "routines": []})[folder].append(name)

    for (schema, name, kind), cols in sorted(objects.items()):
        is_view = "VIEW" in str(kind).upper()
        folder = "views" if is_view else "tables"
        concept_type = TYPE_NAME.get(provider, {}).get(
            str(kind).upper(), f"{provider} {'View' if is_view else 'Table'}")
        approx, analyzed = count_by.get((schema, name), (None, None))

        body = [frontmatter(
            concept_type, f"{schema}.{name}",
            f"{'View' if is_view else 'Table'} {schema}.{name} in {database or provider}.",
            [provider, slug(schema), "schema"], timestamp)]
        body.append(f"# {schema}.{name}\n")
        if approx is not None:
            note = f"Approximate rows: **{approx}**"
            if analyzed:
                note += f" (statistics last updated {analyzed})"
            body.append(note + "\n")
        elif not is_view:
            body.append("Approximate rows: unknown — statistics unavailable.\n")

        body.append("## Columns\n")
        body.append(md_table([(c[3], c[4], c[5], c[6], c[7], c[8]) for c in cols],
                             ["column", "type", "length", "precision", "scale", "nullable"]))

        body.append("\n## Indexes\n")
        rows = idx_by.get((schema, name), [])
        body.append(md_table([r[2:] for r in rows],
                             ["index"] + [f"detail{i}" for i in range(1, len(rows[0]) - 2)])
                    if rows else "_none_\n")

        body.append("\n## Keys and joins\n")
        krows = key_by.get((schema, name), [])
        if krows:
            lines = ["| type | constraint | column | references |", "|---|---|---|---|"]
            for k in krows:
                ref = k[5]
                if ref:
                    # link within the same schema first, then any schema
                    target = (schema, ref) if (schema, ref) in known else \
                             next((o for o in known if o[1] == ref), None)
                    if target:
                        rel = f"{slug(ref)}.md" if target[0] == schema \
                              else f"../../{slug(target[0])}/tables/{slug(ref)}.md"
                        ref = f"[{ref}]({rel})"
                lines.append(f"| {k[2]} | {k[3]} | {k[4] or ''} | {ref or ''} |")
            body.append("\n".join(lines) + "\n")
        else:
            body.append("_none_\n")

        path = os.path.join(out_dir, slug(schema), folder)
        os.makedirs(path, exist_ok=True)
        with open(os.path.join(path, f"{slug(name)}.md"), "w", encoding="utf-8") as f:
            f.write("\n".join(body))
        record(schema, folder, name)

    # routines: one concept per function / procedure
    for r in sorted(routines):
        schema, name, kind, args, returns, comment = (list(r) + [None] * 6)[:6]
        body = [frontmatter(
            f"{provider} {str(kind).title()}", f"{schema}.{name}",
            (comment or f"{str(kind).title()} {schema}.{name}.").replace("\n", " "),
            [provider, slug(schema), "routine"], timestamp)]
        body.append(f"# {schema}.{name}\n")
        body.append(f"- Kind: `{kind}`")
        body.append(f"- Arguments: `{args or 'none'}`")
        if returns:
            body.append(f"- Returns: `{returns}`")
        body.append("\n> An existing routine. Prefer calling this over writing a new one that "
                    "duplicates it. Read its definition in source control before proposing a change.\n")
        path = os.path.join(out_dir, slug(schema), "routines")
        os.makedirs(path, exist_ok=True)
        with open(os.path.join(path, f"{slug(name)}.md"), "w", encoding="utf-8") as f:
            f.write("\n".join(body))
        record(schema, "routines", name)

    # per-folder index files
    for schema, folders in written.items():
        for folder, label in [("tables", "Tables"), ("views", "Views"), ("routines", "Routines")]:
            names = sorted(set(folders[folder]))
            if not names:
                continue
            idx = [frontmatter("Index", f"{schema} {label}",
                               f"{label} in schema {schema}.",
                               [provider, slug(schema), "index"], timestamp)]
            idx.append(f"# {schema} — {label}\n")
            idx += [f"- [{n}]({slug(n)}.md)" for n in names]
            with open(os.path.join(out_dir, slug(schema), folder, "index.md"),
                      "w", encoding="utf-8") as f:
                f.write("\n".join(idx) + "\n")

        sidx = [frontmatter("Schema", schema, f"Schema {schema} in {database or provider}.",
                            [provider, slug(schema), "index"], timestamp)]
        sidx.append(f"# {schema}\n")
        for folder, label in [("tables", "Tables"), ("views", "Views"), ("routines", "Routines")]:
            if folders[folder]:
                sidx.append(f"- [{label}]({folder}/index.md) — {len(set(folders[folder]))}")
        with open(os.path.join(out_dir, slug(schema), "index.md"), "w", encoding="utf-8") as f:
            f.write("\n".join(sidx) + "\n")

    root = [frontmatter("Database", database or provider,
                        f"Schema knowledge bundle for the {provider} database "
                        f"{database or ''} on {host}.", [provider, "schema"], timestamp)]
    root.append(f"# {database or provider}\n")
    root.append(f"Provider: **{provider}**  |  Host: `{host}`  |  Generated: {timestamp}\n")
    root.append("> Row counts are approximate and depend on current statistics "
                "(ANALYZE on PostgreSQL, DBMS_STATS on Oracle). Check the statistics date on each "
                "concept before relying on a count for a performance decision.\n")
    root.append("## Schemas\n")
    for schema in sorted(written):
        f_ = written[schema]
        root.append(f"- [{schema}]({slug(schema)}/index.md) — "
                    f"{len(set(f_['tables']))} tables, {len(set(f_['views']))} views, "
                    f"{len(set(f_['routines']))} routines")
    with open(os.path.join(out_dir, "index.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(root) + "\n")

    totals = [sum(len(set(written[s][k])) for s in written) for k in ("tables", "views", "routines")]
    return totals


def main():
    p = argparse.ArgumentParser(description="Dump database schema as an OKF v0.1 knowledge bundle.")
    p.add_argument("--config", help="path to a specific appsettings json file")
    p.add_argument("--name", help="which named connection string to use")
    p.add_argument("--provider", choices=["postgres", "sqlserver", "oracle"],
                   help="override auto-detection")
    p.add_argument("--objects", help="comma separated table/view names to include")
    p.add_argument("--out", help="bundle directory (default docs/db/<provider>)")
    p.add_argument("--list", action="store_true",
                   help="list discovered connections and exit without connecting")
    args = p.parse_args()

    if args.list:
        found = load_connections(find_config_files(args.config))
        if not found:
            print("No ConnectionStrings section found in any appsettings*.json")
            return
        for path, name, raw in found:
            parts = parse_connection_string(expand_placeholders(raw))
            provider = detect_provider(raw, parts) or "unknown"
            host, _ = split_host_port(pick(parts, "host"), provider)
            pwd = pick(parts, "password")
            if not pwd:
                has_pwd = "no (set DB_PASSWORD)"
            elif re.search(r"\$\{[A-Za-z_]|%[A-Za-z_][A-Za-z0-9_]*%", pwd):
                has_pwd = "placeholder (set that env var, or DB_PASSWORD)"
            else:
                has_pwd = "yes"
            print(f"{path}: {name} -> provider={provider} host={host} "
                  f"db={pick(parts, 'database')} password_in_file={has_pwd}")
        return

    provider, parts, source = resolve_connection(args)
    if provider not in QUERIES:
        sys.exit("Could not determine the provider. Re-run with --provider.")

    conn, host, database = connect(provider, parts)
    print(f"Connected: provider={provider} host={host} database={database} (from {source})")

    objects = {o.strip().upper() for o in args.objects.split(",")} if args.objects else None
    sections = {}
    for key, (sql, headers) in QUERIES[provider].items():
        try:
            rows = [r for r in run(conn, sql) if keep(r, objects)]
        except Exception as exc:                      # noqa: BLE001
            rows = []
            print(f"  {key}: query failed ({type(exc).__name__}) — "
                  f"check the account has catalog read permission", file=sys.stderr)
        sections[key] = (rows, headers)
    conn.close()

    out_dir = args.out or os.path.join("docs", "db", provider)
    timestamp = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    os.makedirs(out_dir, exist_ok=True)
    n_t, n_v, n_r = write_bundle(out_dir, provider, host, database, sections, timestamp)
    print(f"Wrote OKF bundle to {out_dir}/ ({n_t} tables, {n_v} views, {n_r} routines)")


if __name__ == "__main__":
    main()

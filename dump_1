#!/usr/bin/env python3
"""
Dump database schema to a markdown snapshot the design agent can read.

Works against SQL Server, PostgreSQL and Oracle. The provider is detected from the
connection string found in appsettings*.json, so the same command works in every
application repository without per-app configuration.

    python scripts/dump_schema.py                          # auto-discover appsettings
    python scripts/dump_schema.py --list                   # show what it found, connect to nothing
    python scripts/dump_schema.py --config src/Api/appsettings.Development.json
    python scripts/dump_schema.py --name TradeStore        # pick a named connection
    python scripts/dump_schema.py --objects Trades,vw_Book # limit to these objects

Credential resolution, first hit wins:
    1. DB_CONNECTION_STRING environment variable
    2. DB_USER / DB_PASSWORD environment variables, merged over the appsettings values
    3. the connection string in appsettings*.json

${VAR} and %VAR% placeholders inside a connection string are expanded from the
environment, so repos that keep secrets out of source still work.

The password is never printed and never written to the snapshot.

Drivers — install only what your applications actually use:
    pip install "psycopg[binary]"   # PostgreSQL
    pip install pyodbc              # SQL Server (also needs MS ODBC Driver 18 at OS level)
    pip install oracledb            # Oracle
"""
import argparse
import datetime as dt
import glob
import json
import os
import re
import sys

# --------------------------------------------------------------------------
# provider detection
# --------------------------------------------------------------------------

PROVIDER_HINTS = [
    ("postgres", ["host=", "username=", "port=5432"]),
    ("sqlserver", ["initial catalog=", "integrated security=", "trustservercertificate=", "server=tcp:"]),
    ("oracle", ["(description", "(service_name=", "user id="]),
]

SYNONYMS = {
    "host":     ["server", "host", "data source", "addr", "address", "network address"],
    "port":     ["port"],
    "database": ["database", "initial catalog", "dbname", "db"],
    "user":     ["user id", "uid", "username", "user"],
    "password": ["password", "pwd"],
}

DEFAULT_PORT = {"postgres": "5432", "sqlserver": "1433", "oracle": "1521"}


def expand_placeholders(value):
    def sub(match):
        name = match.group(1) or match.group(2)
        return os.environ.get(name, match.group(0))
    return re.sub(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}|%([A-Za-z_][A-Za-z0-9_]*)%", sub, value)


def parse_connection_string(cs):
    parts = {}
    for chunk in cs.split(";"):
        if "=" not in chunk:
            continue
        key, _, value = chunk.partition("=")
        parts[key.strip().lower()] = value.strip()
    return parts


def detect_provider(cs, parts, explicit=None):
    if explicit:
        return explicit
    lowered = cs.lower()
    for provider, tokens in PROVIDER_HINTS:
        if any(token in lowered for token in tokens):
            return provider
    if "host" in parts and "username" in parts:
        return "postgres"
    if "initial catalog" in parts or "server" in parts:
        return "sqlserver"
    if "data source" in parts and "user id" in parts:
        return "oracle"
    return None


def pick(parts, component):
    for key in SYNONYMS[component]:
        if key in parts and parts[key]:
            return parts[key]
    return None


def split_host_port(host, provider):
    """SQL Server writes server,port. Others write host:port."""
    if host is None:
        return None, None
    if provider == "sqlserver" and "," in host:
        h, _, p = host.partition(",")
        return h.strip(), p.strip()
    if provider != "sqlserver" and host.count(":") == 1:
        h, _, p = host.partition(":")
        return h.strip(), p.strip()
    return host.strip(), None


# --------------------------------------------------------------------------
# appsettings discovery
# --------------------------------------------------------------------------

SEARCH_GLOBS = ["appsettings*.json", "src/**/appsettings*.json", "**/appsettings*.json"]


def find_config_files(explicit):
    if explicit:
        if not os.path.exists(explicit):
            sys.exit(f"Config file not found: {explicit}")
        return [explicit]
    seen, found = set(), []
    for pattern in SEARCH_GLOBS:
        for path in glob.glob(pattern, recursive=True):
            norm = path.replace("\\", "/")
            if "/bin/" in norm or "/obj/" in norm:
                continue
            real = os.path.realpath(path)
            if real in seen:
                continue
            seen.add(real)
            found.append(path)
    return found


def load_connections(paths):
    """Return [(file, name, connection_string)] from every ConnectionStrings section."""
    out = []
    for path in paths:
        try:
            with open(path, encoding="utf-8-sig") as f:
                data = json.load(f)
        except (json.JSONDecodeError, OSError) as exc:
            print(f"  skipped {path}: {exc}", file=sys.stderr)
            continue
        section = data.get("ConnectionStrings") or data.get("connectionStrings") or {}
        if isinstance(section, dict):
            for name, value in section.items():
                if isinstance(value, str) and "=" in value:
                    out.append((path, name, value))
    return out


def resolve_connection(args):
    env_cs = os.environ.get("DB_CONNECTION_STRING")
    if env_cs:
        cs = expand_placeholders(env_cs)
        parts = parse_connection_string(cs)
        return detect_provider(cs, parts, args.provider), parts, "DB_CONNECTION_STRING"

    candidates = load_connections(find_config_files(args.config))
    if not candidates:
        sys.exit(
            "No connection string found.\n"
            "Looked for a ConnectionStrings section in appsettings*.json.\n"
            "Pass --config <path>, or set DB_CONNECTION_STRING."
        )

    if args.name:
        candidates = [c for c in candidates if c[1].lower() == args.name.lower()]
        if not candidates:
            sys.exit(f"No connection named '{args.name}' found. Run --list to see the options.")
    elif len({(n) for _, n, _ in candidates}) > 1:
        names = ", ".join(sorted({f"{n} ({os.path.basename(p)})" for p, n, _ in candidates}))
        sys.exit(
            f"Multiple connection strings found: {names}\n"
            "Re-run with --name <ConnectionName> to choose one."
        )

    path, name, raw = candidates[0]
    cs = expand_placeholders(raw)
    parts = parse_connection_string(cs)
    provider = detect_provider(cs, parts, args.provider)

    # Environment credentials override whatever is in the file.
    if os.environ.get("DB_USER"):
        for key in ("uid", "username", "user"):
            parts.pop(key, None)
        parts["user id"] = os.environ["DB_USER"]
    if os.environ.get("DB_PASSWORD"):
        parts.pop("pwd", None)
        parts["password"] = os.environ["DB_PASSWORD"]

    return provider, parts, f"{path} -> {name}"


# --------------------------------------------------------------------------
# connect
# --------------------------------------------------------------------------

def connect(provider, parts):
    raw_host = pick(parts, "host")
    host, embedded_port = split_host_port(raw_host, provider)
    port = embedded_port or pick(parts, "port") or DEFAULT_PORT.get(provider)
    database = pick(parts, "database")
    user = pick(parts, "user")
    password = pick(parts, "password")

    def unresolved(v):
        return bool(v) and bool(re.search(r"\$\{[A-Za-z_]|%[A-Za-z_][A-Za-z0-9_]*%", v))

    missing = [n for n, v in [("host", host), ("user", user), ("password", password)]
               if not v or unresolved(v)]
    if missing:
        sys.exit(
            f"Connection string is missing or unresolved: {', '.join(missing)}.\n"
            "If secrets are supplied at runtime, set them before re-running:\n"
            "  export DB_USER=...   export DB_PASSWORD=...\n"
            "or export DB_CONNECTION_STRING with the full string."
        )

    driver_hint = {"postgres": 'pip install "psycopg[binary]"',
                   "sqlserver": "pip install pyodbc  (plus MS ODBC Driver 18 at OS level)",
                   "oracle": "pip install oracledb"}

    def need(module):
        try:
            return __import__(module)
        except ImportError:
            sys.exit(f"Driver not installed for {provider}.\n  {driver_hint[provider]}")

    if provider == "postgres":
        psycopg = need("psycopg")
        return psycopg.connect(host=host, port=port, dbname=database,
                               user=user, password=password), host, database

    if provider == "sqlserver":
        pyodbc = need("pyodbc")
        driver = os.environ.get("ODBC_DRIVER", "ODBC Driver 18 for SQL Server")
        return pyodbc.connect(
            f"DRIVER={{{driver}}};SERVER={host},{port};DATABASE={database};"
            f"UID={user};PWD={password};TrustServerCertificate=yes",
            readonly=True,
        ), host, database

    if provider == "oracle":
        oracledb = need("oracledb")
        dsn = raw_host if (raw_host or "").strip().startswith("(") \
            else f"{host}:{port}/{database or ''}"
        return oracledb.connect(user=user, password=password, dsn=dsn), host, database

    sys.exit("Could not determine the provider. Re-run with --provider postgres|sqlserver|oracle.")



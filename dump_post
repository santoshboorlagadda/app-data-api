#!/usr/bin/env python3
"""
Writes a single-file schema gist to docs/db/schema.md for the design agent to read.

Setup once:
    pip install "psycopg[binary]"
    fill in the CONFIG block below

Then it is run by the agent, or manually:
    python scripts/dump_schema.py
"""
import datetime as dt
import os
import sys

# ==========================================================================
HOST     = "REPLACE_ME_HOST"
PORT     = "5432"
DATABASE = "REPLACE_ME_DATABASE"
USER     = "REPLACE_ME_USER"
PASSWORD = "REPLACE_ME_PASSWORD"
SCHEMAS  = ["public"]                    # e.g. ["sales", "staging"]
OUT      = os.path.join("docs", "db", "schema.md")
# ==========================================================================


def main():
    if "REPLACE_ME" in HOST + DATABASE + USER + PASSWORD:
        sys.exit("Fill in the CONFIG block at the top of scripts/dump_schema.py first.")
    try:
        import psycopg
    except ImportError:
        sys.exit('Driver missing. Run:  pip install "psycopg[binary]"')

    where = "(" + ", ".join(f"'{s}'" for s in SCHEMAS) + ")"
    conn = psycopg.connect(host=HOST, port=PORT, dbname=DATABASE, user=USER, password=PASSWORD)
    print(f"Connected: {USER}@{HOST}/{DATABASE} schemas={SCHEMAS}")

    def q(sql):
        try:
            with conn.cursor() as cur:
                cur.execute(sql)
                return [tuple(r) for r in cur.fetchall()]
        except Exception as exc:                                        # noqa: BLE001
            print(f"  query failed: {type(exc).__name__}: {exc}", file=sys.stderr)
            return []

    cols = q(f"""SELECT c.table_schema, c.table_name, t.table_type, c.column_name,
                        c.data_type, c.is_nullable
                 FROM information_schema.columns c
                 JOIN information_schema.tables t
                   ON t.table_schema=c.table_schema AND t.table_name=c.table_name
                 WHERE c.table_schema IN {where}
                 ORDER BY c.table_schema, c.table_name, c.ordinal_position""")

    idxs = q(f"""SELECT schemaname, tablename, indexname, indexdef
                 FROM pg_indexes WHERE schemaname IN {where}""")

    keys = q(f"""SELECT tc.table_schema, tc.table_name, tc.constraint_type,
                        kcu.column_name, ccu.table_name
                 FROM information_schema.table_constraints tc
                 LEFT JOIN information_schema.key_column_usage kcu
                        ON kcu.constraint_name=tc.constraint_name
                 LEFT JOIN information_schema.constraint_column_usage ccu
                        ON ccu.constraint_name=tc.constraint_name
                       AND tc.constraint_type='FOREIGN KEY'
                 WHERE tc.table_schema IN {where}
                   AND tc.constraint_type IN ('PRIMARY KEY','FOREIGN KEY','UNIQUE')""")

    rows = q(f"""SELECT schemaname, relname, n_live_tup FROM pg_stat_user_tables
                 WHERE schemaname IN {where}""")
    if not rows or all((r[2] or 0) == 0 for r in rows):
        rows = q(f"""SELECT n.nspname, c.relname, c.reltuples::bigint
                     FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
                     WHERE c.relkind='r' AND n.nspname IN {where}""")
        print("  row counts: using pg_class.reltuples estimate")

    routines = q(f"""SELECT n.nspname, p.proname,
                            CASE p.prokind WHEN 'f' THEN 'function'
                                           WHEN 'p' THEN 'procedure' ELSE 'other' END,
                            pg_get_function_arguments(p.oid),
                            pg_get_function_result(p.oid)
                     FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
                     WHERE n.nspname IN {where}
                     ORDER BY n.nspname, p.proname""")
    conn.close()

    # --- assemble ---
    rowcount = {(r[0], r[1]): r[2] for r in rows}
    idx_by, pk_by, fk_by, uq_by = {}, {}, {}, {}
    for r in idxs:
        definition = r[3].split("USING", 1)[-1].strip() if "USING" in r[3] else r[3]
        idx_by.setdefault((r[0], r[1]), []).append(f"{r[2]} {definition}")
    for s_, t_, kind, col, ref in keys:
        if kind == "PRIMARY KEY":
            pk_by.setdefault((s_, t_), []).append(col)
        elif kind == "FOREIGN KEY":
            fk_by.setdefault((s_, t_), []).append(f"{col} -> {ref}")
        elif kind == "UNIQUE":
            uq_by.setdefault((s_, t_), []).append(col)

    objects = {}
    for s_, t_, kind, col, typ, nullable in cols:
        objects.setdefault((s_, t_, kind), []).append(
            f"{col} {typ}{'' if nullable == 'YES' else ' NOT NULL'}")

    ts = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    out = [
        "---",
        'type: "Database Schema"',
        f'title: "{DATABASE}"',
        f'description: "Schema gist for the PostgreSQL database {DATABASE}: tables, views, '
        'columns, keys, indexes, approximate row counts and existing routines."',
        f"tags: [postgres, schema, {', '.join(SCHEMAS)}]",
        f"timestamp: {ts}",
        "---",
        "",
        f"# {DATABASE} — schema gist",
        "",
        f"PostgreSQL on `{HOST}`. Schemas: {', '.join(SCHEMAS)}. Generated {ts}.",
        "Row counts are approximate. Use them for order-of-magnitude decisions only.",
        "",
    ]

    tables = sorted(k for k in objects if "VIEW" not in k[2].upper())
    views = sorted(k for k in objects if "VIEW" in k[2].upper())

    out.append("## Tables\n")
    for (s_, t_, _), collist in ((k, objects[k]) for k in tables):
        n = rowcount.get((s_, t_))
        out.append(f"### {s_}.{t_}" + (f"  — ~{n:,} rows" if n is not None else ""))
        out.append(f"- columns: {', '.join(collist)}")
        if pk_by.get((s_, t_)):
            out.append(f"- pk: {', '.join(sorted(set(pk_by[(s_, t_)])))}")
        if fk_by.get((s_, t_)):
            out.append(f"- fk: {'; '.join(sorted(set(fk_by[(s_, t_)])))}")
        if uq_by.get((s_, t_)):
            out.append(f"- unique: {', '.join(sorted(set(uq_by[(s_, t_)])))}")
        if idx_by.get((s_, t_)):
            out.append(f"- indexes: {'; '.join(sorted(set(idx_by[(s_, t_)])))}")
        out.append("")

    out.append("## Views\n")
    for (s_, t_, _), collist in ((k, objects[k]) for k in views):
        out.append(f"### {s_}.{t_}")
        out.append(f"- columns: {', '.join(collist)}")
        out.append("")
    if not views:
        out.append("_none_\n")

    out.append("## Existing functions and procedures\n")
    out.append("Check this list before designing a new routine — reuse or extend beats duplicating.\n")
    for s_, name, kind, args, ret in routines:
        out.append(f"- `{s_}.{name}` ({kind}) ({args or ''})" + (f" returns {ret}" if ret else ""))
    if not routines:
        out.append("_none_")
    out.append("")

    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w", encoding="utf-8") as f:
        f.write("\n".join(out))
    print(f"Wrote {OUT} ({len(tables)} tables, {len(views)} views, {len(routines)} routines)")


if __name__ == "__main__":
    main()
